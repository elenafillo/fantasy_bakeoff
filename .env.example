# Copy to .env.local and fill in. Never commit the filled-in version.
# The same three are set in Vercel under Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → the SECRET one (sb_secret_… or the
# legacy service_role JWT). Bypasses row-level security completely: anyone
# holding it can read every prediction and rewrite every score. Server-side
# only — it is read in api/_supabase.js and must never be imported under src/.
SUPABASE_SERVICE_ROLE_KEY=

# Whatever you like. Checked server-side in api/gm.js on every GM request.
# You will be typing it on a phone mid-episode, so pick accordingly.
GM_PASSWORD=
